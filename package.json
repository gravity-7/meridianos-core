{
  "name": "@gravity-7/meridianos-core",
  "version": "0.3.9",
  "private": false,
  "type": "module",
  "description": "MeridianOS — provider/harness-agnostic autonomous agent-orchestration core. Tenant behavior injected via a DomainPlugin.",
  "main": "./config.mjs",
  "exports": {
    ".": "./config.mjs",
    "./*": "./*"
  },
  "bin": {
    "meridian-gateway": "./gateway/cli.mjs",
    "meridianos": "./init.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "bun": "^1.1.34",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "systray": "^1.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravity-7/meridianos-core.git"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\" \"tests/integration/*.mjs\" \"gateway/tests/*.test.mjs\"",
    "test:ci": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\" \"tests/integration/*.mjs\" \"gateway/tests/cli.test.mjs\" \"gateway/tests/ide-attribution.test.mjs\" \"gateway/tests/inject-openai.test.mjs\" \"gateway/tests/inject.test.mjs\" \"gateway/tests/ledger.test.mjs\" \"gateway/tests/provider-registry.test.mjs\" \"gateway/tests/registry-pull.test.mjs\" \"gateway/tests/registry-source.test.mjs\" \"gateway/tests/run-registry.test.mjs\" \"gateway/tests/token-event.test.mjs\" \"gateway/tests/windows.test.mjs\" \"gateway/tests/wire-adapter-registry.test.mjs\"",
    "test:slow": "node --disable-warning=ExperimentalWarning --test \"gateway/tests/server.test.mjs\" \"gateway/tests/server-openai.test.mjs\" \"gateway/tests/index.test.mjs\"",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "benchmark": "node scripts/benchmark-api.mjs"
  }
}
