node_modules/
# transient publish-time npmrc (holds only an env-var reference, never a token) — belt-and-suspenders
.npmrc.publish

# Isolated per-run worktrees for the Track-A subagent swarm (never committed to core).
.mos-worktrees/

# Orchestrator runtime state that is machine-local, not durable memory (DBs, logs, secrets).
# The DURABLE orchestrator memory (.ai/memory, .ai/contracts, .ai/cards, OWNERSHIP.md) IS committed
# via the negations at the bottom of this file — this blanket rule replaced a set of scoped-subpath
# rules that missed .ai/auth/ and root-level .ai/*.db files (an actual secret + DB leak incident,
# see git history remediation).
.ai/
.playwright-mcp/

# Transient PR review artifacts — auto-generated per-PR (prompts, outputs, diffs, context)
.ai/reviews/

# Provider wizard backup files — timestamped policy snapshots created during provider add
.ai/policy.backup.*.yaml
.ai/reports/

# Spec-kit runtime state (actual feature specs are committed in specs/)
.ai/features/

# Machine-local runtime state
.ai/dashboards/
.ai/runs/
.ai/state/

# Spec-kit package cache — auto-generated, machine-specific
.specify/.cache/

# IDE tracking and research data — local analytics, not source
.copilot-tracking/

# Temporary / experimental workspace
scratch/

# Isolated per-run worktrees (same pattern as .mos-worktrees/)
.aios-worktrees/
# Durable orchestrator memory — these ARE committed (overrides blanket .ai/ ignores above)
!.ai/memory/
!.ai/contracts/
!.ai/cards/
!.ai/OWNERSHIP.md
# Sensitive planning and research — local-only, never commit
docs/MASTER-PLAN-CLOSE-GAPS.md

# Root-level scratch/debug artifacts — not source, previously leaked into a commit by accident
/debug-activity.db
/debug-activity.mjs
/test-output.txt