import assert from 'node:assert/strict';
import { fetchTasks, createTask, updateTask, handleWebhook } from './index.mjs';

assert.equal(typeof fetchTasks, 'function', 'fetchTasks must be a function');
assert.equal(typeof createTask, 'function', 'createTask must be a function');
assert.equal(typeof updateTask, 'function', 'updateTask must be a function');
