// TODO: replace with your real test configuration (use a sandbox/test account, never production).
const mockConfig = { example_field: 'test-value', api_token: 'test-token' };

const tasks = await fetchTasks(mockConfig);
assert.ok(Array.isArray(tasks), 'fetchTasks must return an array');
for (const task of tasks) {
